# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.ipynb_checkpoints/

# Raw datasets and model weights are never committed. Fetch them with scripts/download_data.py.
/data/
*.parquet
*.pcap
*.pt
*.bin
*.safetensors

# Per-run logs stay local; raw and summary artifacts are committed in place.
results/*/logs/
results/_logs/*.log
results/MANIFEST.lock

# Caches
.pytest_cache/
.ruff_cache/
*.log
